# ==============================================================================
# KI-TALII - Esempio di variabili d'ambiente
# Rinomina questo file in '.env' e inserisci le tue credenziali reali.
# ==============================================================================

# URL API del tuo server Kimai (inclusa la parte /api finale)
KIMAI_BASE_URL=https://tuo-kimai.example.com/api

# Token API personale Kimai
KIMAI_TOKEN=tuo_api_token_qui

# Nome utente Kimai
KIMAI_USERNAME=nome.cognome

# URL API locale di ActivityWatcher
ACTIVITYWATCHER_BASE_URL=http://localhost:5600/api/0
